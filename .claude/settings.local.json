{
  "permissions": {
    "allow": [
      "Bash(docker exec *)",
      "Bash(awk '{print $NF}')",
      "Bash(npm view *)",
      "Bash(npm install *)",
      "Bash(xargs ls *)"
    ]
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/home/helder/.local/bin/headroom wrap selfheal --marker headroom-wrap-selfheal",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
